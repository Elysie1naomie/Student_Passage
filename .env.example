# Copier vers .env puis remplir les valeurs locales. Ne jamais committer .env.

# Environnement : development | test | production
APP_ENV=development

# Base PostgreSQL (développement local, à adapter)
POSTGRES_USER=passage
POSTGRES_PASSWORD=
POSTGRES_DB=passage
# Reprendre ici le même mot de passe que POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://passage:<mot-de-passe>@localhost:5432/passage

# Clé de signature des sessions, à générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Fuseau d'affichage (stockage en UTC)
TIMEZONE=Africa/Douala

# Fournisseur IA : laisser vide pour le mode sans clé (synthèse par gabarit)
AI_API_KEY=

# Frontend : URL de l'API
VITE_API_URL=http://localhost:8000
